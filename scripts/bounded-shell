#!/usr/bin/env bash
set -euo pipefail

if ! ulimit -S -v 16777216 || ! ulimit -H -v 16777216; then
    echo "Could not set the 16 GiB per-process address-space limit." >&2
    exit 125
fi

axial_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
axial_python="${axial_root}/envs/axial-modeling/bin/python"
if [[ ! -x "${axial_python}" ]]; then
    axial_python=python3
fi
exec "${axial_python}" "${axial_root}/scripts/resource_guard.py" /bin/bash "$@"
